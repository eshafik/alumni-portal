[Unit]
Description=Alumni Portal
After=network.target

[Service]
Type=simple
User=alumni-portal
Group=alumni-portal
WorkingDirectory=/opt/alumni-portal
EnvironmentFile=/opt/alumni-portal/.env
ExecStart=/opt/alumni-portal/alumni-portal
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/alumni-portal

[Install]
WantedBy=multi-user.target
