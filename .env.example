# Copy this file to .env and fill in real values — it's loaded automatically on startup
# (internal/config.Load) via godotenv, so `go run ./cmd/server` or the built binary picks up
# .env with no extra steps. Any variable already set in the real shell/systemd environment
# takes priority over .env, so this is safe to ship as-is in production (where secrets should
# come from systemd's EnvironmentFile=, not a committed .env).

APP_ENV=development
PORT=8080
DB_PATH=./data/data.db

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=

PUBLIC_BASE_URL=http://localhost:8080
SESSION_SECRET=dev-insecure-secret-change-me

# IANA timezone the frontend displays all dates/times in (server-generated timestamps are
# stored in UTC regardless of this setting — this only controls display). Exposed publicly via
# GET /api/institution.
TIMEZONE=Asia/Dhaka

# First-boot bootstrap for the initial SuperAdmin account (no public "become admin" endpoint exists).
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changeme123

# Leave SMTP_HOST empty in dev — emails are logged to stdout instead of sent (check the server
# log for the OTP code). Once set, the server logs the resolved SMTP config (host/port/user/from,
# never the password) on every startup, and logs every send attempt's success/failure — if an
# OTP doesn't arrive, the log will say exactly why.
SMTP_HOST=
# 587 = STARTTLS (most providers, recommended). 465 = implicit TLS/SSL (also supported). 25 = plaintext.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# Display name shown as the sender, e.g. "My University Alumni Portal <no-reply@example.com>"
SMTP_FROM_NAME=Alumni Portal

# Admin Outreach (bulk email/SMS to alumni/students, see /admin/outreach). Both channels ship
# dormant by default — flip to true only once SMTP (above) / the SMS driver below are actually
# configured, otherwise campaigns fail loudly by design rather than silently no-op.
OUTREACH_EMAIL_ENABLE=false
OUTREACH_SMS_ENABLE=false

# Cost shown to the admin per recipient before they send — purely informational (this app never
# charges/bills anyone), just surfaced in the UI so the estimated cost is meaningful.
EMAIL_COST_PER_UNIT=1
EMAIL_COST_CURRENCY=BDT
SMS_COST_PER_UNIT=0.5
SMS_COST_CURRENCY=BDT

# Which SMS driver internal/smsgateway uses. "twilio" (default) or "bulksmsbd".
SMS_DRIVER=twilio

# bulksmsbd.net — only needed if SMS_DRIVER=bulksmsbd
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=

# Twilio — only needed if SMS_DRIVER=twilio (the default). TWILIO_FROM_NUMBER must be a Twilio
# phone number in E.164 (e.g. +1415XXXXXXX).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
